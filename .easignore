# EAS Build needs app.json and eas.json to build at all, even though
# they're gitignored (they contain embedded API keys we don't want in the
# public repo). .easignore takes priority over .gitignore for EAS's own
# upload, so mirror .gitignore here and then un-ignore those two files.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

.env

.agents
.commandcode

# Supabase CLI local state
supabase/.temp

# Needed by EAS Build even though they're gitignored — must be last.
!app.json
!eas.json
